{
  "name": "@joshua-dallas/cumulus",
  "version": "1.1.1",
  "type": "module",
  "author": "Joshua Dallas",
  "description": "A JS library containing a custom HTML element that draws a generative hatched-style image of cumulus clouds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshua-dallas/cumulus.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://joshua-dallas.github.io/cumulus/",
  "bugs": {
    "url": "https://github.com/joshua-dallas/cumulus/issues"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "canvas",
    "generative-art",
    "cloud",
    "cumulus"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./dist/cumulus.js",
  "module": "./dist/cumulus.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/cumulus.js"
    },
    "./define": {
      "types": "./dist/types/define.d.ts",
      "default": "./dist/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/define.js",
    "./dist/define.js"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types",
    "build:demo": "vite build --config vite.demo.config.js",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint src test e2e",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run format:check && npm run audit && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
