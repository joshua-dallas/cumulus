{
  "name": "@joshua-dallas/cumulus",
  "version": "1.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshua-dallas/cumulus.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/cumulus.js",
  "module": "./dist/cumulus.js",
  "exports": {
    ".": "./dist/cumulus.js",
    "./define": "./dist/define.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./src/define.js",
    "./dist/define.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src test",
    "test": "node --test test/*.test.js",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
